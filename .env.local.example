# Existing OSS-register endpoint.
ORT_REPOSITORIES_URL=https://api.developer.overheid.nl/oss-register/v1/repositories

# API key for the register GET.
ORT_REGISTER_API_KEY=

# Optional OAuth client credentials; fill in all three or leave all empty.
# Token URL: https://auth.developer.overheid.nl/realms/don/protocol/openid-connect/token
AUTH_TOKEN_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPES=

# Leave empty until the scan-results endpoint exists.
ORT_RESULTS_URL=
