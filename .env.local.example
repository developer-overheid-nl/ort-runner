# Existing OSS-register endpoint.
ORT_REPOSITORIES_URL=https://api.developer.overheid.nl/oss-register/v1/repositories

# A read-only API key can authenticate only the existing GET endpoint.
ORT_REGISTER_API_KEY=

# Client credentials authenticate result POSTs.
AUTH_TOKEN_URL=https://auth.developer.overheid.nl/realms/don/protocol/openid-connect/token
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPES=

# Leave empty until the scan-results endpoint exists.
ORT_RESULTS_URL=
